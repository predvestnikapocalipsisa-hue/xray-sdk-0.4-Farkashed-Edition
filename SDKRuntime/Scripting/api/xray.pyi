from collections.abc import Callable, Iterator
from contextlib import AbstractContextManager
from pathlib import Path
from typing import Any, Literal

API_VERSION: Literal[1]
Vector3 = tuple[float, float, float]
JSON = Any

class Object:
    handle: int
    name: str
    position: Vector3
    rotation: Vector3  # Radians.
    scale: Vector3
    selected: bool
    visible: bool
    @property
    def class_id(self) -> int: ...
    @property
    def reference(self) -> str | None: ...
    def delete(self) -> None: ...

class _Scene:
    @property
    def objects(self) -> list[Object]: ...
    @property
    def selected_objects(self) -> list[Object]: ...
    def find(self, name: str) -> Object | None: ...
    def create(self, kind: Literal["object", "light", "shape", "glow", "way"], name: str = "", reference: str = "", position: Vector3 = (0, 0, 0)) -> Object: ...
    def transaction(self, label: str = "Python operation") -> AbstractContextManager[None]: ...

class Context:
    @property
    def editor(self) -> Literal["level", "actor", "particle", "shader"]: ...
    @property
    def sdk_root(self) -> Path: ...
    @property
    def scene(self) -> _Scene: ...
    @property
    def selected_objects(self) -> list[Object]: ...

context: Context
scene: _Scene

class Operator:
    bl_idname: str
    bl_label: str
    bl_options: set[str]
    bl_shortcut: str
    def execute(self, context: Context) -> Any: ...

class Panel:
    bl_idname: str
    bl_label: str
    def draw(self, context: Context) -> None: ...

def operator(idname: str, label: str | None = None, *, undo: bool = True, shortcut: str = "") -> Callable[[Callable[[Context], Any]], Callable[[Context], Any]]: ...
def panel(idname: str, label: str | None = None) -> Callable[[Callable[[Context], None]], Callable[[Context], None]]: ...
def log(*values: object) -> None: ...

class _UI:
    def text(self, value: object) -> None: ...
    def label(self, value: object) -> None: ...
    def button(self, label: str) -> bool: ...
    def checkbox(self, label: str, value: bool) -> bool: ...
    def input_float(self, label: str, value: float, step: float = .1, fast_step: float = 1) -> float: ...
    def slider_float(self, label: str, value: float, minimum: float, maximum: float) -> float: ...
    def input_text(self, label: str, value: str) -> str: ...
    def separator(self) -> None: ...
    def same_line(self) -> None: ...
    def collapsing_header(self, label: str) -> bool: ...
    def operator(self, idname: str, label: str | None = None) -> Any: ...
ui: _UI

class _Ops:
    def list(self) -> list[str]: ...
    def execute(self, command: str, p0: str | int = 0, p1: str | int = 0) -> str | int: ...
    def call(self, idname: str) -> Any: ...
ops: _Ops

class _Utils:
    def register_class(self, cls: type[Operator] | type[Panel]) -> None: ...
    def unregister_class(self, cls: type[Operator] | type[Panel]) -> None: ...
utils: _Utils

class _Events:
    def subscribe(self, event: str, callback: Callable[[Any], None]) -> object: ...
    def unsubscribe(self, token: object) -> None: ...
events: _Events

class _Timers:
    def register(self, callback: Callable[[], float | None], first_interval: float = .1) -> object: ...
    def unregister(self, token: object) -> None: ...
timers: _Timers

class _Preferences:
    def load(self) -> JSON: ...
    def save(self, value: JSON) -> None: ...
preferences: _Preferences

class _Lua:
    def eval(self, expression: str) -> JSON: ...
    def execute(self, source: str) -> JSON: ...
    def reset(self) -> None: ...
    def call(self, name: str, *arguments: JSON) -> JSON: ...
lua: _Lua

class _Addons:
    directory: Path
    records: dict[str, dict[str, Any]]
    def refresh(self) -> None: ...
    def enable(self, identifier: str, *, persist: bool = True) -> None: ...
    def disable(self, identifier: str) -> None: ...
    def reload(self, identifier: str) -> None: ...
    def install(self, filename: str | Path) -> str: ...
    def uninstall(self, identifier: str) -> None: ...
    def create_template(self) -> Path: ...
    def open_folder(self) -> None: ...
addons: _Addons

class _App:
    api_version: Literal[1]
    timers: _Timers
    events: _Events
    def request_exit(self) -> None: ...
app: _App
