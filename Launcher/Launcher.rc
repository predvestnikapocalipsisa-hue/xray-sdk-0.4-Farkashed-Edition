#include <windows.h>
#include "../LauncherAssets/ResourceIds.h"
#include "SdkBuildInfo.rcinc"
IDR_SDK_BUILD_INFO RCDATA "SdkBuildInfo.txt"
1 ICON "assets/gui/Icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SDK_VERSION_NUMBERS
 PRODUCTVERSION SDK_VERSION_NUMBERS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "X-Ray SDK Farkashed Edition Launcher\0"
            VALUE "FileVersion", SDK_VERSION_TEXT
            VALUE "ProductVersion", SDK_VERSION_TEXT
            VALUE "ProductName", "X-Ray SDK Farkashed Edition\0"
            VALUE "OriginalFilename", "Launcher.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
IDR_SDK_UPDATE_SCRIPT RCDATA "UpdateWorker.ps1"
IDR_SDK_RESOURCE_WORKER RCDATA "ResourceWorker.cs"
IDR_SDK_RESOURCE_SCRIPT RCDATA "ResourceWorker.ps1"
IDR_SDK_7ZIP_EXE RCDATA "third_party/7zip/7z.exe"
IDR_SDK_7ZIP_DLL RCDATA "third_party/7zip/7z.dll"
IDR_SDK_7ZIP_LICENSE RCDATA "third_party/7zip/License.txt"
IDR_SDK_7ZIP_README RCDATA "third_party/7zip/README.md"
